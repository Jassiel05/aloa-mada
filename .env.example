# Sur Vercel, ces 3 clés Supabase sont ajoutées automatiquement par l'intégration Supabase ↔ Vercel.
# En local : Supabase > Project Settings > API (ou Data API)
NEXT_PUBLIC_SUPABASE_URL=https://xxxxxxxx.supabase.co
# La clé "anon" (ou la nouvelle "publishable key", elle fonctionne aussi)
NEXT_PUBLIC_SUPABASE_ANON_KEY=eyJhbGciOi...
# Facultatif : votre nom de domaine. Sur Vercel l'adresse est détectée automatiquement.
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# --- Phase 2 : emails (côté serveur uniquement, ne jamais exposer) ---
# Supabase > Project Settings > API > service_role (ou "secret key")
SUPABASE_SERVICE_ROLE_KEY=
# Clé API de https://resend.com (sans clé, aucun email n'est envoyé)
RESEND_API_KEY=
# Expéditeur : un domaine vérifié chez Resend, ex. "Aloa-Mada <bonjour@aloa-mada.com>"
EMAIL_FROM=Aloa-Mada <onboarding@resend.dev>
