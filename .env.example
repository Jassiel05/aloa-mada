# Supabase : RIEN à saisir. L'adresse et la clé publique du projet sont déjà dans
# src/lib/supabase/env.ts. Si l'intégration Supabase <-> Vercel ajoute ses variables, elles priment.
# NEXT_PUBLIC_SUPABASE_URL=https://jvjwcnugivibhrrsaiqs.supabase.co
# NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=sb_publishable_...
# Facultatif : votre nom de domaine. Sur Vercel l'adresse est détectée automatiquement.
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# --- Phase 2 : emails (côté serveur uniquement, ne jamais exposer) ---
# Supabase > Project Settings > API > service_role (ou "secret key")
SUPABASE_SERVICE_ROLE_KEY=
# Clé API de https://resend.com (sans clé, aucun email n'est envoyé)
RESEND_API_KEY=
# Expéditeur : un domaine vérifié chez Resend, ex. "Aloa-Mada <bonjour@aloa-mada.com>"
EMAIL_FROM=Aloa-Mada <onboarding@resend.dev>
